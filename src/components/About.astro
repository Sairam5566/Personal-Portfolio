---
/**
 * About.astro — About section (Clean Centered Layout)
 */
import { personal, skills, achievements } from '../data/content.js';

const categories = [...new Set(skills.map((s: any) => s.category))];
---

<section id="about" class="relative py-24 md:py-32 overflow-hidden">
  <!-- Subtle bg accent -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 80% 50% at 50% 0%, #00E5CC05 0%, transparent 70%);" aria-hidden="true"></div>

  <div class="relative z-10 w-full max-w-5xl mx-auto px-6 md:px-12 flex flex-col items-center">

    <!-- Section header -->
    <div class="mb-16 gsap-reveal text-center" data-section="about">
      <span class="font-mono-accent text-brand-cyan text-xs tracking-widest uppercase mb-3 block">// about me</span>
      <h2 class="font-display font-bold text-brand-text" style="font-size: clamp(2rem, 5vw, 3.2rem);">
        Who I Am
      </h2>
      <div class="mt-4 h-px max-w-[120px] mx-auto bg-gradient-to-r from-transparent via-brand-cyan to-transparent"></div>
    </div>

    <!-- Bio Statement -->
    <div class="relative w-full text-center mb-16 gsap-reveal" data-section="about">
      <p class="font-display text-brand-text text-lg md:text-xl leading-relaxed max-w-3xl mx-auto">
        Final-year CSE student at SRM IST specialising in <span class="text-brand-cyan font-medium">Cloud Computing</span> — skilled in <span class="text-brand-cyan font-medium">Python</span>, <span class="text-brand-cyan font-medium">Java</span>, and <span class="text-brand-cyan font-medium">SQL</span>, with hands-on experience spanning full-stack development and data science pipelines. Adept at building robust <span class="text-brand-cyan font-medium">REST APIs</span> and implementing AI-driven features.
      </p>
    </div>

    <!-- Quick Facts -->
    <div class="w-full mb-16 gsap-reveal" data-section="about">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { label: "currently at", value: "SRM Institute of Science & Technology" },
          { label: "degree",       value: "B.Tech CSE — Cloud Computing (2023–2027)" },
          { label: "based in",     value: "Chennai, India" },
          { label: "seeking",      value: "Full-time / Internship opportunities" },
        ].map(({ label, value }) => (
          <div class="p-5 rounded-2xl border border-brand-border bg-brand-surface text-center hover:border-brand-cyan/40 transition-colors duration-300">
            <span class="font-mono-accent text-[9px] uppercase tracking-widest text-brand-cyan block mb-2">{label}</span>
            <span class="font-display text-xs text-brand-text leading-snug">{value}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- ① SKILLS & TECHNOLOGIES (before achievements) -->
    <div class="w-full mb-16 gsap-reveal flex flex-col items-center" data-section="about">
      <div class="flex items-center gap-4 mb-10 w-full">
        <div class="flex-1 h-px bg-brand-border"></div>
        <h3 class="font-mono-accent text-brand-cyan text-xs tracking-widest uppercase whitespace-nowrap">Skills &amp; Technologies</h3>
        <div class="flex-1 h-px bg-brand-border"></div>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full">
        {categories.map((cat: any, index: number) => {
          const colSpan = index === 0 ? "md:col-span-2" : "md:col-span-1";
          return (
            <div class={`p-6 rounded-2xl border border-brand-border bg-brand-surface hover:border-brand-border/70 transition-colors duration-300 ${colSpan}`}>
              <p class="font-mono-accent text-brand-dim text-[10px] uppercase tracking-widest mb-5">
                → {(cat as string).toLowerCase()}
              </p>
              <div class="flex flex-wrap gap-2">
                {skills
                  .filter((s: any) => s.category === cat)
                  .map((skill: any) => (
                    <div
                      class="skill-pill group flex items-center gap-2 px-3 py-1.5 rounded-lg border border-brand-border bg-brand-bg hover:border-brand-cyan/50 hover:bg-brand-surfaceHi cursor-default transition-all duration-200"
                      data-cursor="hover"
                      title={skill.name}
                    >
                      <span class="text-sm group-hover:scale-110 transition-transform duration-200 inline-block" aria-hidden="true">{skill.icon}</span>
                      <span class="font-mono-accent text-xs text-brand-muted group-hover:text-brand-text transition-colors duration-200">{skill.name}</span>
                    </div>
                  ))}
              </div>
            </div>
          )
        })}
      </div>
    </div>

    <!-- ② ACHIEVEMENTS (after skills) -->
    <div class="w-full gsap-reveal flex flex-col items-center" data-section="about">
      <div class="flex items-center gap-4 mb-10 w-full">
        <div class="flex-1 h-px bg-brand-border"></div>
        <h3 class="font-mono-accent text-brand-cyan text-xs tracking-widest uppercase whitespace-nowrap">Achievements</h3>
        <div class="flex-1 h-px bg-brand-border"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 w-full">
        {achievements.map((ach: any) => (
          <div class="p-6 rounded-2xl border border-brand-border bg-brand-surface hover:border-brand-cyan/40 transition-all duration-300 group text-center flex flex-col items-center">
            <div class="mb-4 text-brand-cyan" aria-hidden="true">
              <svg class="w-5 h-5 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
              </svg>
            </div>
            {ach.link ? (
              <a href={ach.link} target="_blank" rel="noopener noreferrer" class="font-display text-brand-text text-sm leading-snug hover:text-brand-cyan transition-colors duration-200" data-cursor="hover">
                {ach.title}
              </a>
            ) : (
              <p class="font-display text-brand-text text-sm leading-snug">{ach.title}</p>
            )}
            <p class="font-mono-accent text-brand-muted text-[10px] uppercase tracking-wider mt-4">{ach.date}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    gsap.utils.toArray<HTMLElement>('[data-section="about"].gsap-reveal').forEach((el, i) => {
      gsap.fromTo(el,
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 90%', end: 'top 60%', scrub: 0.5 },
        }
      );
    });

    ScrollTrigger.create({
      trigger: '#about',
      start: 'top 65%',
      once: true,
      onEnter: () => {
        gsap.fromTo('.skill-pill',
          { opacity: 0, y: 12, scale: 0.92 },
          { opacity: 1, y: 0, scale: 1, duration: 0.35, stagger: 0.035, ease: 'back.out(1.4)' }
        );
      },
    });
  } else {
    document.querySelectorAll<HTMLElement>('.gsap-reveal').forEach(el => {
      el.style.opacity = '1'; el.style.transform = 'none';
    });
  }
</script>
