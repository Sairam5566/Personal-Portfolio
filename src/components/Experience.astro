---
/**
 * Experience.astro — Experience & Education section (Centered Layout)
 */
import { experience, education } from '../data/content.js';
---

<section id="experience" class="relative py-28 md:py-36 flex flex-col items-center overflow-hidden">
  <!-- Background -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 60% 40% at 20% 60%, #C084FC04 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 w-full max-w-4xl mx-auto px-8 md:px-12 flex flex-col items-center">

    <!-- Section header -->
    <div class="mb-16 gsap-reveal text-center" data-section="exp">
      <span class="font-mono-accent text-brand-cyan text-xs tracking-widest uppercase mb-3 block">// experience & education</span>
      <h2 class="font-display font-bold text-brand-text" style="font-size: clamp(2rem, 5vw, 3.2rem);">
        My Journey
      </h2>
      <div class="mt-4 h-px max-w-[120px] mx-auto bg-gradient-to-r from-transparent via-brand-cyan to-transparent"></div>
    </div>

    <div class="w-full flex flex-col items-center gap-16">

      <!-- Experience -->
      <div class="w-full flex flex-col items-center">
        <h3 class="font-mono-accent text-brand-cyan text-xs tracking-widest uppercase mb-10 gsap-reveal bg-brand-bg px-4 z-10 py-1 border border-brand-border rounded-full" data-section="exp">
          Work Experience
        </h3>

        <div class="w-full space-y-8 relative">
          <div class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-px bg-brand-border -z-10" aria-hidden="true"></div>
          
          {experience.map((exp: any, i: number) => (
            <div class="exp-item gsap-reveal w-full group p-8 rounded-3xl border border-brand-border bg-brand-surface hover:border-brand-cyan transition-all duration-300" data-section="exp">
              <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-6">
                <div>
                  <h4 class="font-display font-semibold text-brand-text text-xl md:text-2xl leading-snug">
                    {exp.role}
                  </h4>
                  <p class="font-display text-brand-cyan text-base mt-1">{exp.company}</p>
                </div>
                <div class="text-left md:text-right shrink-0">
                  <p class="font-mono-accent text-sm text-brand-muted bg-brand-bg px-3 py-1 rounded-full border border-brand-border inline-block md:block">{exp.period}</p>
                  <p class="font-mono-accent text-xs text-brand-muted mt-2">{exp.location}</p>
                </div>
              </div>

              <ul class="space-y-3 mt-6 border-t border-brand-border pt-6">
                {exp.bullets.map((bullet: string) => (
                  <li class="flex gap-3 text-base">
                    <span class="text-brand-cyan mt-1 shrink-0 text-sm" aria-hidden="true">▸</span>
                    <span class="font-display text-brand-muted leading-relaxed">{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Education -->
      <div class="w-full flex flex-col items-center mt-8">
        <h3 class="font-mono-accent text-brand-lime text-xs tracking-widest uppercase mb-10 gsap-reveal bg-brand-bg px-4 z-10 py-1 border border-brand-border rounded-full" data-section="exp">
          Education
        </h3>

        <div class="w-full space-y-8 relative">
          <div class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-px bg-brand-border -z-10" aria-hidden="true"></div>

          {education.map((edu: any, i: number) => (
            <div class="edu-item gsap-reveal w-full group p-8 rounded-3xl border border-brand-border bg-brand-surface hover:border-brand-lime transition-all duration-300" data-section="exp">
              <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 mb-4">
                <div class="flex-1">
                  <h4 class="font-display font-semibold text-brand-text text-lg md:text-xl leading-snug">
                    {edu.institution}
                  </h4>
                  <p class="font-display text-brand-muted text-base mt-2">{edu.degree}</p>
                </div>
                <div class="shrink-0 text-left md:text-right">
                  <span class="font-mono-accent text-sm text-brand-muted bg-brand-bg px-3 py-1 rounded-full border border-brand-border inline-block">{edu.period}</span>
                </div>
              </div>
              <div class="flex items-center gap-4 mt-6 border-t border-brand-border pt-6">
                <span class="font-mono-accent text-sm font-medium px-4 py-1.5 rounded-full" style="background: #A8FF7811; color: #A8FF78; border: 1px solid #A8FF7833;">
                  {edu.score}
                </span>
                <span class="font-mono-accent text-xs text-brand-muted">{edu.location}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    // Reveal animations
    gsap.utils.toArray<HTMLElement>('[data-section="exp"].gsap-reveal').forEach((el) => {
      gsap.fromTo(el,
        { opacity: 0, y: 30 },
        {
          opacity: 1, y: 0, ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 90%', end: 'top 60%', scrub: 0.5 },
        }
      );
    });
  } else {
    document.querySelectorAll<HTMLElement>('.gsap-reveal').forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
  }
</script>
