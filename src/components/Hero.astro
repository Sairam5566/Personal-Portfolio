---
/**
 * Hero.astro — Landing section
 * ─────────────────────────────
 * Design Direction: KINETIC / MOTION-FIRST
 *
 * Signature interactions:
 *   1. Text-scramble effect on name (letters cycle through random chars)
 *   2. Role text cycles through titles
 *   3. Animated grid background that subtly shifts on scroll
 *   4. CTA buttons are magnetic
 *   5. Scroll indicator with animated arrow
 */
import { personal } from '../data/content.js';
---

<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden noise-bg"
>
  <!-- Animated grid background -->
  <div
    class="absolute inset-0 bg-grid-pattern bg-grid-lg opacity-100"
    aria-hidden="true"
    id="hero-grid"
  ></div>

  <!-- Radial glow blobs -->
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full pointer-events-none"
    style="background: radial-gradient(circle, #00E5CC08 0%, transparent 70%);"
    aria-hidden="true"
    id="hero-glow"
  ></div>
  <div
    class="absolute top-20 right-10 w-64 h-64 rounded-full pointer-events-none"
    style="background: radial-gradient(circle, #A8FF7808 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Hero content wrapper: two-column layout on lg+ screens -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-8 md:px-12 lg:px-16 xl:px-20 pt-28 pb-24 lg:pt-0 lg:pb-0 min-h-screen flex flex-col lg:flex-row items-center justify-center gap-12 lg:gap-16">

    <!-- Left column: text content -->
    <div class="flex-1 max-w-2xl w-full">

      <!-- Eyebrow -->
      <p
        class="font-mono-accent text-brand-cyan text-sm tracking-[0.2em] mb-6 gsap-reveal"
        id="hero-eyebrow"
      >
        &gt; hello_world.init()
      </p>

      <!-- Name with scramble effect -->
      <h1
        class="font-display font-bold text-brand-text mb-5 leading-none tracking-tight"
        style="font-size: clamp(3rem, 7vw, 6.5rem);"
      >
        <span
          id="scramble-text"
          data-target="Sairam"
          class="block text-brand-cyan gsap-reveal"
          aria-label="Sairam"
        >Sairam</span>
        <span
          class="block text-brand-text gsap-reveal"
        >Lakshmanan</span>
      </h1>

      <!-- Role cycling -->
      <div class="flex items-center gap-3 mb-5 gsap-reveal">
        <span class="text-brand-muted font-mono-accent text-sm">//</span>
        <div class="overflow-hidden h-8">
          <p
            id="role-cycle"
            class="font-display text-xl md:text-2xl text-brand-text font-medium leading-8"
          >
            Full-Stack Developer
          </p>
        </div>
      </div>

      <!-- Tagline -->
      <p
        class="font-display text-brand-muted text-lg md:text-xl max-w-lg mb-10 leading-relaxed gsap-reveal"
      >
        I build systems that scale and interfaces that matter.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4 mb-14 gsap-reveal">
        <a
          href="#projects"
          class="magnetic group relative px-7 py-3.5 font-mono-accent text-sm font-medium text-brand-bg bg-brand-cyan rounded-lg overflow-hidden glow-cyan transition-all duration-300"
          data-cursor="hover"
          id="cta-projects"
        >
          <span class="magnetic-inner relative z-10">view work →</span>
          <span class="absolute inset-0 bg-brand-lime scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out"></span>
        </a>
        <a
          href="#contact"
          class="magnetic group relative px-7 py-3.5 font-mono-accent text-sm font-medium text-brand-cyan border border-brand-cyan rounded-lg overflow-hidden transition-all duration-300 hover:text-brand-bg"
          data-cursor="hover"
          id="cta-contact"
        >
          <span class="magnetic-inner relative z-10">get in touch</span>
          <span class="absolute inset-0 bg-brand-cyan scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out"></span>
        </a>
        <a
          href="mailto:sairamlakshmanan2005@gmail.com"
          class="magnetic group relative px-7 py-3.5 font-mono-accent text-sm font-medium text-brand-muted border border-brand-border rounded-lg overflow-hidden hover:border-brand-muted hover:text-brand-text transition-all duration-300"
          data-cursor="hover"
        >
          <span class="magnetic-inner relative z-10">résumé</span>
        </a>
      </div>

      <!-- Stat counters -->
      <div class="flex gap-10 pt-6 border-t border-brand-border gsap-reveal">
        {[
          { value: "3+", label: "Projects Built" },
          { value: "8.66", label: "CGPA" },
          { value: "130+", label: "LeetCode Problems" },
        ].map(({ value, label }) => (
          <div class="group">
            <div class="font-display text-3xl font-bold text-brand-cyan group-hover:text-brand-lime transition-colors duration-300">
              {value}
            </div>
            <div class="font-mono-accent text-xs text-brand-muted mt-1">{label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right column: Interactive Photo Frame -->
    <div
      class="shrink-0 hidden lg:flex items-center justify-center group"
      id="hero-photo-wrap"
    >
      <div class="relative w-56 h-56 xl:w-72 xl:h-72 cursor-pointer perspective-1000" id="photo-container">
        <!-- Outer Glowing Aura (expands & brightens on hover) -->
        <div
          class="absolute -inset-4 rounded-full bg-gradient-to-r from-brand-cyan via-brand-lime to-purple-500 opacity-20 blur-xl group-hover:opacity-60 group-hover:scale-110 transition-all duration-500 ease-out pointer-events-none"
          id="photo-aura"
        ></div>

        <!-- Glowing Gradient Ring (static gradient, magnetic tilt on hover) -->
        <div
          class="relative w-full h-full rounded-full p-[3px] bg-gradient-to-tr from-brand-cyan via-brand-lime to-purple-400 shadow-2xl transition-all duration-500 ease-out group-hover:shadow-[0_0_40px_rgba(0,229,204,0.4)]"
          id="photo-frame"
        >
          <!-- Inner image container with zoom effect -->
          <div class="w-full h-full rounded-full bg-brand-surface overflow-hidden relative flex items-center justify-center">
            
            <!-- Shimmer / Light Beam effect on hover -->
            <div
              class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out z-20 pointer-events-none"
            ></div>

            <!-- Profile image / fallback -->
            <!-- To use your photo, add image file to public/photo.jpg and update src below -->
            <div class="w-full h-full flex flex-col items-center justify-center gap-2 text-brand-muted transition-transform duration-500 ease-out group-hover:scale-105" id="photo-content">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-brand-cyan opacity-40 group-hover:opacity-80 group-hover:scale-110 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span class="font-mono-accent text-xs text-brand-cyan/60 group-hover:text-brand-cyan transition-colors">Sairam Lakshmanan</span>
            </div>

          </div>
        </div>

        <!-- Decorative tech badge hovering on bottom right -->
        <div class="absolute -bottom-2 -right-2 px-3.5 py-1 rounded-full bg-brand-bg/90 border border-brand-cyan/40 backdrop-blur-md text-brand-cyan font-mono-accent text-[10px] tracking-wider shadow-lg group-hover:border-brand-lime group-hover:text-brand-lime group-hover:scale-105 transition-all duration-300 pointer-events-none">
          AVAILABLE FOR HIRE
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2"
    aria-hidden="true"
  >
    <span class="font-mono-accent text-xs text-brand-muted tracking-widest">scroll</span>
    <div class="w-px h-10 bg-gradient-to-b from-brand-cyan to-transparent animate-pulse"></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── GSAP entrance animations ──────────────────────────────
  if (!prefersReduced) {
    gsap.utils.toArray<HTMLElement>('#hero .gsap-reveal').forEach((el, i) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 0.8, delay: i * 0.12, ease: 'power3.out' }
      );
    });

    // Photo wrap entrance
    gsap.fromTo(
      '#hero-photo-wrap',
      { opacity: 0, x: 40 },
      { opacity: 1, x: 0, duration: 1.0, delay: 0.3, ease: 'power3.out' }
    );

    // 3D Tilt & Magnetic Hover Animation for Photo Frame
    const photoContainer = document.getElementById('photo-container');
    const photoFrame = document.getElementById('photo-frame');

    if (photoContainer && photoFrame) {
      photoContainer.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = photoContainer.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        const rotateX = (-y / (rect.height / 2)) * 14;
        const rotateY = (x / (rect.width / 2)) * 14;

        gsap.to(photoFrame, {
          rotateX: rotateX,
          rotateY: rotateY,
          x: x * 0.12,
          y: y * 0.12,
          duration: 0.3,
          ease: 'power2.out',
          transformPerspective: 800,
        });
      });

      photoContainer.addEventListener('mouseleave', () => {
        gsap.to(photoFrame, {
          rotateX: 0,
          rotateY: 0,
          x: 0,
          y: 0,
          duration: 0.6,
          ease: 'elastic.out(1, 0.4)',
        });
      });
    }

    // Parallax grid on scroll
    gsap.to('#hero-grid', {
      yPercent: 20,
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 1,
      },
    });

    // Glow parallax
    gsap.to('#hero-glow', {
      yPercent: -15,
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 2,
      },
    });
  }

  // ── Text Scramble Effect ─────────────────────────────────
  // Runs regardless of reduced-motion (it's subtle and quick)
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%';
  const scrambleEl = document.getElementById('scramble-text');

  function scramble(el: HTMLElement, finalText: string) {
    let iterations = 0;
    const maxIter = finalText.length * 5;
    const interval = setInterval(() => {
      el.textContent = finalText
        .split('')
        .map((char, i) => {
          if (i < Math.floor(iterations / 5)) return char;
          return chars[Math.floor(Math.random() * chars.length)];
        })
        .join('');
      if (iterations >= maxIter) {
        clearInterval(interval);
        el.textContent = finalText;
      }
      iterations++;
    }, 30);
  }

  if (scrambleEl) {
    const target = scrambleEl.getAttribute('data-target') || scrambleEl.textContent || '';
    setTimeout(() => scramble(scrambleEl, target), 400);
  }

  // ── Role cycling ─────────────────────────────────────────
  const roles = [
    'Full-Stack Developer',
    'AI Enthusiast',
    'Backend Engineer',
    'Problem Solver',
    'CSE @ SRM IST',
  ];
  const roleCycleEl = document.getElementById('role-cycle');

  if (roleCycleEl && !prefersReduced) {
    let currentIndex = 0;
    setInterval(() => {
      currentIndex = (currentIndex + 1) % roles.length;
      gsap.to(roleCycleEl, {
        yPercent: -100,
        opacity: 0,
        duration: 0.3,
        ease: 'power2.in',
        onComplete: () => {
          roleCycleEl.textContent = roles[currentIndex];
          gsap.fromTo(
            roleCycleEl,
            { yPercent: 100, opacity: 0 },
            { yPercent: 0, opacity: 1, duration: 0.4, ease: 'power2.out' }
          );
        },
      });
    }, 2500);
  }
</script>
