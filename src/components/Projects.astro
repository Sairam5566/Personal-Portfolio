---
/**
 * Projects.astro — Projects section (Clean Stacked Cards)
 */
import { projects } from '../data/content.js';
---

<section id="projects" class="relative py-24 md:py-32">
  <!-- Subtle bg -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 70% 40% at 80% 50%, #A8FF7803 0%, transparent 70%);" aria-hidden="true"></div>

  <div class="relative z-10 w-full max-w-5xl mx-auto px-6 md:px-12 flex flex-col items-center">

    <!-- Section header -->
    <div class="mb-16 gsap-reveal text-center" data-section="projects">
      <span class="font-mono-accent text-brand-cyan text-xs tracking-widest uppercase mb-3 block">// projects</span>
      <h2 class="font-display font-bold text-brand-text" style="font-size: clamp(2rem, 5vw, 3.2rem);">
        Things I've Built
      </h2>
      <div class="mt-4 h-px max-w-[120px] mx-auto bg-gradient-to-r from-transparent via-brand-cyan to-transparent"></div>
    </div>

    <!-- Stacked Cards -->
    <div class="w-full flex flex-col gap-6">
      {projects.map((project: any, index: number) => (
        <article
          class="project-card group relative w-full rounded-3xl border border-brand-border bg-brand-surface overflow-hidden transition-all duration-500 hover:border-brand-border/80"
          style={`--accent: ${project.accentColor};`}
          id={`project-${project.id}`}
        >
          <!-- Decorative number watermark -->
          <div class="absolute top-4 right-6 font-display font-bold select-none pointer-events-none opacity-[0.06]" style={`font-size: clamp(5rem, 12vw, 9rem); color: ${project.accentColor}; line-height: 1;`} aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </div>

          <!-- Top accent line -->
          <div class="absolute top-0 left-0 right-0 h-px" style={`background: linear-gradient(90deg, transparent, ${project.accentColor}44, transparent);`}></div>

          <div class="relative z-10 p-8 md:p-10">
            <!-- Meta -->
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <div class="w-2 h-2 rounded-full" style={`background-color: ${project.accentColor}; box-shadow: 0 0 8px ${project.accentColor};`}></div>
              {project.featured && (
                <span class="font-mono-accent text-[10px] tracking-widest uppercase" style={`color: ${project.accentColor};`}>
                  featured
                </span>
              )}
              <span class="font-mono-accent text-[10px] text-brand-muted border border-brand-border bg-brand-bg px-3 py-1 rounded-full ml-auto">
                {project.period}
              </span>
            </div>

            <!-- Title -->
            <h3 class="font-display font-bold text-brand-text text-2xl md:text-3xl leading-tight mb-5 group-hover:text-brand-cyan transition-colors duration-300">
              {project.title}
            </h3>

            <!-- Description -->
            <p class="font-display text-brand-muted text-sm md:text-base leading-relaxed mb-8 max-w-3xl">
              {project.description}
            </p>

            <!-- Footer: tags + links -->
            <div class="flex flex-col sm:flex-row sm:items-end gap-6">
              <!-- Tags -->
              <div class="flex flex-wrap gap-2 flex-1">
                {project.tags.map((tag: string) => (
                  <span class="font-mono-accent text-[11px] px-3 py-1 rounded-full border border-brand-border bg-brand-bg text-brand-muted">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Links — GitHub always visible -->
              <div class="flex items-center gap-3 shrink-0">
                {/* GitHub button — always shown */}
                {project.github ? (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="magnetic inline-flex items-center gap-2 font-mono-accent text-xs px-4 py-2 rounded-lg border border-brand-border bg-brand-bg text-brand-muted hover:border-brand-cyan hover:text-brand-cyan transition-all duration-200"
                    data-cursor="hover"
                    aria-label={`View ${project.shortTitle} on GitHub`}
                  >
                    <span class="magnetic-inner flex items-center gap-2">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                      </svg>
                      GitHub
                    </span>
                  </a>
                ) : (
                  <span
                    class="inline-flex items-center gap-2 font-mono-accent text-xs px-4 py-2 rounded-lg border border-dashed border-brand-border/50 bg-brand-bg text-brand-dim cursor-not-allowed select-none"
                    title="GitHub link coming soon"
                  >
                    <svg class="w-4 h-4 opacity-40" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                    </svg>
                    GitHub
                  </span>
                )}

                {/* Live Demo — only if URL exists */}
                {project.live && (
                  <a
                    href={project.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="magnetic inline-flex items-center gap-2 font-mono-accent text-xs px-4 py-2 rounded-lg border transition-all duration-200"
                    style={`color: ${project.accentColor}; border-color: ${project.accentColor}44; background: ${project.accentColor}08;`}
                    data-cursor="hover"
                    aria-label={`View ${project.shortTitle} live`}
                  >
                    <span class="magnetic-inner flex items-center gap-2">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                      Live Demo
                    </span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    gsap.utils.toArray<HTMLElement>('[data-section="projects"].gsap-reveal').forEach((el) => {
      gsap.fromTo(el,
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 90%', end: 'top 60%', scrub: 0.5 },
        }
      );
    });

    document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => {
      gsap.fromTo(card,
        { opacity: 0, y: 40 },
        { opacity: 1, y: 0, ease: 'power2.out',
          scrollTrigger: { trigger: card, start: 'top 90%', end: 'top 60%', scrub: 0.5 },
        }
      );
    });
  } else {
    document.querySelectorAll<HTMLElement>('.gsap-reveal').forEach(el => {
      el.style.opacity = '1'; el.style.transform = 'none';
    });
  }
</script>
