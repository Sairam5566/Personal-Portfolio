---
/**
 * Projects.astro — Projects section (visual centerpiece)
 * ────────────────────────────────────────────────────────
 * Design Direction: KINETIC / MOTION-FIRST
 *
 * Layout: Stacked feature cards with offset asymmetric grid.
 * Signature animation: SVG "connector" line that draws itself
 *   on scroll (ScrollTrigger scrub + drawSVG-style stroke-dashoffset).
 * Featured projects get a larger card with a decorative preview pane.
 * Non-featured projects render in a compact row grid.
 *
 * HOW TO ADD A NEW PROJECT:
 *   Open src/data/content.js and add a new object to the `projects` array.
 *   Set `featured: true` for a large hero card, `false` for compact grid.
 */
import { projects } from '../data/content.js';

const featured = projects.filter((p: any) => p.featured);
const compact  = projects.filter((p: any) => !p.featured);
---

<section id="projects" class="relative py-28 md:py-36 overflow-hidden">
  <!-- Background stripe -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(ellipse 70% 40% at 80% 50%, #A8FF7804 0%, transparent 70%);"
    aria-hidden="true"
  ></div>

  <!-- Scroll-drawn SVG connector line (decorative) -->
  <svg
    id="project-connector"
    class="absolute left-16 top-32 hidden lg:block pointer-events-none"
    width="2" height="70%"
    viewBox="0 0 2 800"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    style="height: 70%;"
  >
    <line
      id="connector-line"
      x1="1" y1="0" x2="1" y2="800"
      stroke="#00E5CC"
      stroke-width="1"
      stroke-dasharray="800"
      stroke-dashoffset="800"
      opacity="0.4"
    />
  </svg>

  <div class="relative z-10 max-w-7xl mx-auto px-8 md:px-12 lg:px-16 xl:px-20">

    <!-- Section header -->
    <div class="mb-20 gsap-reveal" data-section="projects">
      <p class="font-mono-accent text-brand-cyan text-sm tracking-[0.2em] mb-3">02 / projects</p>
      <h2 class="font-display font-bold text-brand-text" style="font-size: clamp(2rem, 5vw, 3.5rem);">
        Things I've Built
      </h2>
      <div class="section-line mt-4 max-w-xs"></div>
    </div>

    <!-- Featured projects -->
    <div class="space-y-24 mb-24">
      {featured.map((project: any, index: number) => (
        <article
          class={`project-card-featured group grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center gsap-reveal`}
          data-section="projects"
          id={`project-${project.id}`}
          style={`--accent: ${project.accentColor};`}
        >
          <!-- Decorative preview pane -->
          <div
            class={`relative rounded-2xl overflow-hidden border border-brand-border bg-brand-surface h-64 lg:h-80 ${index % 2 === 1 ? 'lg:order-2' : ''}`}
          >
            <!-- Animated grid inside card -->
            <div
              class="absolute inset-0 bg-grid-pattern bg-grid-sm"
              style={`opacity: 0.06;`}
            ></div>

            <!-- Project index number (large decorative) -->
            <div
              class="absolute inset-0 flex items-center justify-center"
              aria-hidden="true"
            >
              <span
                class="font-display font-bold text-[10rem] leading-none select-none"
                style={`color: ${project.accentColor}08;`}
              >
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <!-- Floating tech tag cluster -->
            <div class="absolute inset-0 flex flex-wrap gap-2 items-end p-6">
              {project.tags.map((tag: string) => (
                <span
                  class="font-mono-accent text-xs px-3 py-1 rounded-full border border-brand-border bg-brand-bg/80 backdrop-blur-sm"
                  style={`color: ${project.accentColor}; border-color: ${project.accentColor}33;`}
                >
                  {tag}
                </span>
              ))}
            </div>

            <!-- Glow border on hover -->
            <div
              class="absolute inset-0 rounded-2xl border opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              style={`border-color: ${project.accentColor}55; box-shadow: inset 0 0 40px ${project.accentColor}11;`}
            ></div>
          </div>

          <!-- Text content -->
          <div class={`space-y-5 ${index % 2 === 1 ? 'lg:order-1' : ''}`}>
            <div class="flex items-center gap-3">
              <span
                class="font-mono-accent text-xs tracking-widest"
                style={`color: ${project.accentColor};`}
              >
                featured project
              </span>
              <span class="font-mono-accent text-xs text-brand-muted">{project.period}</span>
            </div>

            <h3
              class="font-display font-bold text-brand-text text-2xl md:text-3xl leading-tight group-hover:text-brand-cyan transition-colors duration-300"
            >
              {project.title}
            </h3>

            <div class="p-5 rounded-xl border border-brand-border bg-brand-surface relative">
              <p class="font-display text-brand-muted text-sm leading-relaxed">
                {project.description}
              </p>
            </div>

            <!-- Links -->
            <div class="flex gap-4 pt-2">
              {project.github && project.github !== '#' ? (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="magnetic group/btn flex items-center gap-2 font-mono-accent text-sm text-brand-muted hover:text-brand-cyan transition-colors duration-200"
                  data-cursor="hover"
                  aria-label={`View ${project.title} on GitHub`}
                >
                  <span class="magnetic-inner flex items-center gap-2">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                    </svg>
                    GitHub
                  </span>
                </a>
              ) : (
                <span class="font-mono-accent text-xs text-brand-dim italic">private / in progress</span>
              )}
              {project.live && (
                <a
                  href={project.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="magnetic flex items-center gap-2 font-mono-accent text-sm"
                  style={`color: ${project.accentColor};`}
                  data-cursor="hover"
                  aria-label={`View ${project.title} live`}
                >
                  <span class="magnetic-inner flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    Live Demo
                  </span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Compact projects -->
    {compact.length > 0 && (
      <div>
        <p class="font-mono-accent text-brand-muted text-xs tracking-widest uppercase mb-8">
          // other notable work
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
          {compact.map((project: any) => (
            <article
              class="project-card-compact group relative p-6 rounded-2xl border border-brand-border bg-brand-surface hover:border-brand-cyan transition-all duration-300 hover:-translate-y-1 gsap-reveal"
              data-section="projects"
              style={`--accent: ${project.accentColor};`}
            >
              <!-- Top corner accent -->
              <div
                class="absolute top-0 right-0 w-16 h-16 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none overflow-hidden rounded-2xl"
                aria-hidden="true"
              >
                <div
                  class="absolute -top-8 -right-8 w-16 h-16 rounded-full"
                  style={`background: ${project.accentColor}22;`}
                ></div>
              </div>

              <div class="flex items-start justify-between mb-4">
                <svg class="w-8 h-8 text-brand-muted group-hover:text-brand-cyan transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                </svg>
                <span class="font-mono-accent text-xs text-brand-muted">{project.period}</span>
              </div>

              <h3 class="font-display font-semibold text-brand-text text-lg mb-2 group-hover:text-brand-cyan transition-colors duration-300 leading-snug">
                {project.shortTitle}
              </h3>
              <p class="font-display text-brand-muted text-sm mb-4 leading-relaxed line-clamp-3">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-1.5">
                {project.tags.slice(0, 4).map((tag: string) => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>

              {(project.github && project.github !== '#') && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute inset-0 rounded-2xl"
                  aria-label={`View ${project.title} on GitHub`}
                ></a>
              )}
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    // Scroll-draw the connector line
    gsap.to('#connector-line', {
      strokeDashoffset: 0,
      ease: 'none',
      scrollTrigger: {
        trigger: '#projects',
        start: 'top 60%',
        end: 'bottom 40%',
        scrub: 1.5,
      },
    });

    // Reveal each project card
    gsap.utils.toArray<HTMLElement>('[data-section="projects"].gsap-reveal').forEach((el, i) => {
      gsap.fromTo(el,
        { opacity: 0, y: 40 },
        {
          opacity: 1, y: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: el,
            start: 'top 85%',
            once: true,
          },
        }
      );
    });

    // Hover tilt on featured cards
    document.querySelectorAll<HTMLElement>('.project-card-featured').forEach((card) => {
      const isTouchDevice = window.matchMedia('(pointer: coarse)').matches;
      if (isTouchDevice) return;

      card.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const rx = ((e.clientY - rect.top) / rect.height - 0.5) * 6;
        const ry = ((e.clientX - rect.left) / rect.width - 0.5) * -6;
        gsap.to(card, { rotateX: rx, rotateY: ry, duration: 0.4, ease: 'power2.out', transformPerspective: 800 });
      });
      card.addEventListener('mouseleave', () => {
        gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
      });
    });
  } else {
    document.querySelectorAll<HTMLElement>('.gsap-reveal').forEach((el) => {
      el.style.opacity = '1';
      el.style.transform = 'none';
    });
  }
</script>
