---
---

<div id="resume-modal" class="fixed inset-0 z-[100] flex flex-col items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 bg-brand-bg/90 backdrop-blur-sm p-4 md:p-8" aria-hidden="true" role="dialog" data-lenis-prevent>
  
  <div class="relative w-full max-w-4xl h-full max-h-[90vh] bg-brand-surface border border-brand-border rounded-2xl flex flex-col overflow-hidden shadow-2xl scale-95 transition-transform duration-300" id="resume-modal-content">
    
    <!-- Header -->
    <div class="flex items-center justify-between p-4 border-b border-brand-border bg-brand-surfaceHi shrink-0">
      <h3 class="font-display font-semibold text-brand-text">Resume.pdf</h3>
      <div class="flex gap-2">
        <a href="/Resume.pdf" download class="p-2 rounded-lg hover:bg-brand-bg text-brand-muted hover:text-brand-cyan transition-colors" title="Download">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
        </a>
        <a href="/Resume.pdf" target="_blank" class="p-2 rounded-lg hover:bg-brand-bg text-brand-muted hover:text-brand-cyan transition-colors" title="Open in new tab">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
        <button id="close-resume-modal" class="p-2 rounded-lg hover:bg-brand-bg text-brand-muted hover:text-red-400 transition-colors" title="Close">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
    </div>

    <!-- Viewer -->
    <div class="flex-1 overflow-auto bg-[#222] p-4 md:p-8 relative" id="resume-viewer-container" data-lenis-prevent>
      <!-- Loading indicator -->
      <div id="resume-loader" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-brand-cyan flex flex-col items-center gap-2">
        <svg class="animate-spin w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
        <span class="font-mono-accent text-xs">Loading PDF...</span>
      </div>
      
      <canvas id="resume-canvas" class="shadow-2xl hidden block mx-auto"></canvas>
    </div>
  </div>
</div>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  
  // Set worker via unpkg or cdnjs
  pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjsLib.version}/pdf.worker.min.mjs`;

  const modal = document.getElementById('resume-modal');
  const content = document.getElementById('resume-modal-content');
  const closeBtn = document.getElementById('close-resume-modal');
  const canvas = document.getElementById('resume-canvas') as HTMLCanvasElement;
  const loader = document.getElementById('resume-loader');
  
  let pdfDoc: any = null;
  let pageRendering = false;
  let pdfRendered = false;

  const renderPage = (num: number) => {
    pageRendering = true;
    pdfDoc.getPage(num).then((page: any) => {
      // Calculate scale to fit container width, up to a max scale of 2.0
      const container = document.getElementById('resume-viewer-container');
      let scale = 1.0;
      
      // Calculate padding from container to subtract from available width
      const padding = window.innerWidth >= 768 ? 64 : 32; // md:p-8 (64px) or p-4 (32px)
      
      if (container) {
        const viewportUnscaled = page.getViewport({ scale: 1.0 });
        const widthScale = (container.clientWidth - padding) / viewportUnscaled.width;
        scale = Math.min(widthScale, 2.0); 
      }
      
      const viewport = page.getViewport({ scale });
      const ctx = canvas.getContext('2d');
      
      // Support high DPI displays
      const outputScale = window.devicePixelRatio || 1;
      canvas.width = Math.floor(viewport.width * outputScale);
      canvas.height = Math.floor(viewport.height * outputScale);
      canvas.style.width = Math.floor(viewport.width) + "px";
      canvas.style.height =  Math.floor(viewport.height) + "px";

      const transform = outputScale !== 1 
        ? [outputScale, 0, 0, outputScale, 0, 0] 
        : null;

      const renderContext = {
        canvasContext: ctx,
        transform: transform,
        viewport: viewport
      };
      const renderTask = page.render(renderContext);

      renderTask.promise.then(() => {
        pageRendering = false;
        loader?.classList.add('hidden');
        canvas.classList.remove('hidden');
      });
    });
  };

  const openModal = () => {
    modal?.classList.remove('opacity-0', 'pointer-events-none');
    content?.classList.remove('scale-95');
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';

    if (!pdfRendered) {
      pdfjsLib.getDocument({ url: '/Resume.pdf' }).promise.then((pdf) => {
        pdfDoc = pdf;
        renderPage(1);
        pdfRendered = true;
      }).catch((err) => {
        console.error('Error loading PDF:', err);
        if (loader) loader.innerHTML = `<span class="text-red-400 font-mono-accent">Failed to load PDF. Check network or file path.</span>`;
      });
    }
  };

  const closeModal = () => {
    modal?.classList.add('opacity-0', 'pointer-events-none');
    content?.classList.add('scale-95');
    document.body.style.overflow = '';
    document.documentElement.style.overflow = '';
  };

  // Close bindings
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal?.classList.contains('opacity-0')) closeModal();
  });

  // Export openModal globally so buttons can trigger it
  (window as any).openResumeModal = openModal;

  // Bind to any .resume-btn elements on page
  document.addEventListener('DOMContentLoaded', () => {
    const resumeBtns = document.querySelectorAll('.resume-btn');
    resumeBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });
  });
</script>
